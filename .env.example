# ==============================
# HomNayAnGi - Environment Setup
# ==============================

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# OAuth Google (NextAuth)
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=meal-images

# Prisma (direct Postgres connection string from Supabase > Settings > Database)
# Example format:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=your_supabase_postgres_connection_string

# AI Provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key
# Optional: defaults to gpt-4o-mini if empty
OPENAI_MODEL=gpt-4o-mini

# UI Demo Mode
# true  = use local mock data for UI preview
# false = call real APIs/Supabase data
NEXT_PUBLIC_USE_MOCK_DATA=true

# Quick bypass login button on /auth
# In development this button is enabled by default.
# Set true to force-enable in production-like env for internal demos.
NEXT_PUBLIC_ENABLE_QUICK_LOGIN=false
